// zeta_src/runtime/actor/map.z
// Map (dict) host helpers for the Zeta actor runtime.
//
// The i64 -> i64 map itself is implemented in the Rust host runtime
// (src/runtime/actor/map.rs, backed by HashMap); this file only declares the
// extern interface that generated code links against.
//
// Rewritten in Zeta syntax. The previous revision was Rust source (Box/HashMap)
// which the compiler could only emit as unresolved externals (see issue #26).

extern fn host_map_new() -> i64;
extern fn host_map_insert(ptr: i64, key: i64, val: i64);
extern fn host_map_get(ptr: i64, key: i64) -> i64;
extern fn host_map_free(ptr: i64);
