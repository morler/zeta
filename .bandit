# Bandit configuration for the Qlty `bandit` plugin.
#
# Scope: zetas/capybara/vsr_cluster_test.py is the only Python file in this
# repository that bandit analyzes. It is a local cluster test harness for the
# Capybara DB, not shipped code, so the rules below are disabled for the whole
# file rather than suppressed individually. See issue #17.
#
# Each entry is a rule bandit reports on this file but which does not describe a
# defect here:
#
#   B101  assert_used
#         The harness is a test: `assert` is the assertion mechanism.
#   B108  hardcoded_tmp_directory
#         Directories under /tmp are the harness's deliberate contract with the
#         Capybara binary, which reads its data dir from the command line.
#   B603  subprocess_without_shell_equals_true
#         Every call passes an argument list and never uses a shell. Arguments
#         are module-level constants (CAPYBARA, DIRS), not external input.
#   B604  any_other_function_with_shell_equals_true
#   B607  start_process_with_partial_path
#         `rm` and the Capybara binary are resolved from PATH on purpose so the
#         harness works with either a local build or a system install.
#   B404  import_subprocess
#         Required to launch and manage the replica processes under test.
#
# Anything else bandit finds in this file is still reported.

[bandit]
skips = B101,B108,B603,B604,B607,B404
